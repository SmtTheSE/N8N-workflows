        "jsCode": "// Webhook wraps POST body fields inside j.body\nconst j = $input.first().json;\nconst body = j.body || j; // fallback to j directly if no body wrapper\n\nreturn [{\n  json: {\n    source: body.source || \"manual\",\n    title: body.title || \"Untitled Insight\",\n    url: body.url || null,\n    requester: body.requester || \"unknown\",\n    combined_text: body.raw_text || \"\"\n  }\n}];\n"
      },
